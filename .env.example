# DPS Server Configuration
PORT=3000
NODE_ENV=production

# Public URL of this VPS server (used for generating absolute image URLs)
# Example for VPS: http://103.127.135.206:3000 or https://api.duaputrasrikandi.co.id
BASE_URL=http://103.127.135.206:3000

# Directory where uploaded files and processed WebP images are stored
# On VPS: /home/ideatecore/client/dps/dps-server/uploads
# If left empty or ./uploads, it defaults to the uploads folder inside dps-server
UPLOAD_DIR=/home/ideatecore/client/dps/dps-server/uploads

# Maximum file size in megabytes
MAX_FILE_SIZE_MB=25

# CORS Allowed Origins (comma-separated, or * for all)
ALLOWED_ORIGINS=*
